# 服务监听
GEMINI2A_HOST=127.0.0.1
GEMINI2A_PORT=8787
# 对外暴露的模型名，agent 侧随意写
GEMINI2A_MODEL_NAME=gemini-web

# 设置后要求 Bearer 认证；留空则任何本地程序都能调用
# GEMINI2A_API_KEY=sk-anything

# 单次回复最长等待秒数
GEMINI2A_REQUEST_TIMEOUT=240

# 浏览器可执行文件路径（默认自动探测本机 Chrome/Edge）
# GEMINI2A_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# 自动化浏览器的独立用户目录（相对本目录），登录态持久化在这里
# GEMINI2A_PROFILE_DIR=browser-profile

# 输入模式：auto(默认) / human(全程拟人逐词) / fast(全程快速分块)
GEMINI2A_TYPING_MODE=auto

# 启动时从本机 Chrome/Edge 提取现有登录 cookie 注入自动化浏览器
GEMINI2A_COOKIE_AUTO_EXTRACT=true
